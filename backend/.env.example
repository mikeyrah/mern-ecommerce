PORT=5001
NODE_ENV=production
MONGO_URI=
UPSTASH_REDIS_URL=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
# Public URL of the deployed frontend. For a single-service deployment, use
# the same URL as the API service, for example https://your-app.onrender.com.
CLIENT_URL=
# Optional fulfillment settings. Defaults to $7 shipping below $75 and a
# generic pickup label when omitted.
FLAT_SHIPPING_CENTS=700
PICKUP_LOCATION=Stewart-Tate & Co., 970 N Oak St, Jackson, GA 30233. Pickup hours: 10 AM–6 PM. We'll notify you when your order is ready.
# Gmail requires 2-Step Verification and a 16-character Google App Password.
GMAIL_USER=stewarttateandco@gmail.com
GMAIL_APP_PASSWORD=
# Store inbox that receives new paid-order notifications.
ORDER_NOTIFICATION_EMAIL=stewarttateandco@gmail.com
